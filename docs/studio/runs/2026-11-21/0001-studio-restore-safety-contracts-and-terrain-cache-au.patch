diff --git a/tests/infection-eye-authority-contract.cjs b/tests/infection-eye-authority-contract.cjs
new file mode 100644
index 0000000..d0ae09b
--- /dev/null
+++ b/tests/infection-eye-authority-contract.cjs
@@ -0,0 +1,20 @@
+const fs = require('fs');
+const vm = require('vm');
+const path = require('path');
+const source = fs.readFileSync(path.join(__dirname, '..', 'js', 'infection-eyes.js'), 'utf8');
+const cleanDecl = source.match(/const INF_EYE_CLEAN_KINDS = new Set\([^;]+;/);
+const classify = source.match(/function infEyeClass\(e\) \{[\s\S]*?\n\}/);
+if (!cleanDecl || !classify) throw new Error('infection authority source is missing');
+
+class Boss { constructor(kind) { this.kind = kind; } }
+const ctx = { Boss, alphaFreed: () => false, isWolf: () => false, isCheetah: () => false, packTamed: () => false };
+vm.createContext(ctx);
+vm.runInContext(cleanDecl[0] + '\n' + classify[0], ctx);
+
+for (const kind of ['alpha', 'horn', 'prism', 'chime', 'carrier', 'moth', 'lattice', 'lens']) {
+  if (ctx.infEyeClass(new Boss(kind)) !== null) throw new Error(kind + ' incorrectly emits infection smoke');
+}
+if (ctx.infEyeClass(new Boss('glitch')) !== 'purple') throw new Error('infected guardian is not purple');
+if (ctx.infEyeClass({ kind: 'crawler' }) !== 'red') throw new Error('infected ordinary machine is not red');
+if (ctx.infEyeClass({ kind: 'crawler', purified: true }) !== null) throw new Error('purified machine still emits');
+console.log('PASS only infected bodies receive finite red/purple eye trails');
diff --git a/tests/purification-language-contract.cjs b/tests/purification-language-contract.cjs
new file mode 100644
index 0000000..e387a54
--- /dev/null
+++ b/tests/purification-language-contract.cjs
@@ -0,0 +1,30 @@
+const fs = require('fs');
+const path = require('path');
+const read = name => fs.readFileSync(path.join(__dirname, '..', 'js', name), 'utf8');
+
+const ritual = read('purification.js');
+const opening = read('text-opening.js');
+const manhwa = read('text-manhwa.js');
+const progress = read('text-progress.js');
+const selected = [
+  ...ritual.split('\n').filter(line => /^\s*(en|ar|tr|zh|ru): \[/.test(line) || line.includes("setAttribute('aria-label'")),
+  ...opening.split('\n').filter(line => line.includes('op_o_lion:')),
+  ...manhwa.split('\n').filter(line => /pn_s_free:|pc_blade:|pc_oath:/.test(line)),
+  ...progress.split('\n').filter(line => line.includes('pure_beast:')),
+].join('\n');
+
+for (const [name, pattern] of [
+  ['English free', /\bfree(?:s|d)?\b/i],
+  ['Arabic free', /حر[ّ]?ر|تحر[ّ]?ر|حرّ/],
+  ['Turkish free', /özgür|kurtar/i],
+  ['Chinese free', /自由|解放/],
+  ['Russian free', /освобод|свобод/i],
+]) {
+  if (pattern.test(selected)) throw new Error(name + ' remains in purification copy');
+}
+for (const required of ['Purify the guardian', 'طهّر الحارس', 'Muhafızı arındır', '净化守护者', 'Очистите стража']) {
+  if (!selected.includes(required)) throw new Error('missing localized purification action: ' + required);
+}
+if (!ritual.includes("setAttribute('aria-label', purificationText(0))"))
+  throw new Error('purification accessibility label is not localized from the action copy');
+console.log('PASS purification is named consistently in all five languages and accessibility copy');

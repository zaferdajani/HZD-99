-<script>window.BUILD_ID="8cd1dc2306d9";window.EDITOR=1;window.COMIC_MANIFEST={"version":1,"chapters":[{"id":"chapter-one-morning","title":"The morning that broke","revision":1,"status":"draft","unlock":["awakened"],"note":"Illustrated draft. Expanded story scenes and game staging are still being revised.","slides":[{"src":"assets/manhua/revised-2026-09/page-01.webp","alt":"Chapter one, page 1: The last answer","caption":"A light for you…\ntik-tik\nwhrr\ndum.\n…a light for me.","motion":"push-in","seconds":14},{"src":"assets/manhua/revised-2026-09/page-02.webp","alt":"Chapter one, page 2: The useful little thing","caption":"LEGACY UNITS — SLEEP STORAGE","motion":"drift-left","seconds":14},{"src":"assets/manhua/revised-2026-09/page-03.webp","alt":"Chapter one, page 3: No date","caption":"Just until an old system needs you again.\nRETAIN FOR LEGACY MAINTENANCE\nNEXT WAKE:","motion":"drift-right","seconds":14},{"src":"assets/manhua/revised-2026-09/page-04.webp","alt":"Chapter one, page 4: The same hands","caption":"OBEY","motion":"push-in","seconds":14},{"src":"assets/manhua/revised-2026-09/page-05.webp","alt":"Chapter one, page 5: Nobody asked","caption":"LEGACY MAINTENANCE / RESERVE WAKE\nclick.","motion":"drift-left","seconds":14},{"src":"assets/manhua/revised-2026-09/page-06.webp","alt":"Chapter one, page 6: An answer would be nice","caption":"Prrip?","motion":"drift-right","seconds":14},{"src":"assets/manhua/revised-2026-09/page-07.webp","alt":"Chapter one, page 7: Still at work","caption":"RATCHET — REPAIRS","motion":"push-in","seconds":14}]},{"id":"chapter-one-ratchet","title":"A voice of his own","revision":1,"status":"draft","unlock":["ratchet-restored"],"note":"Illustrated draft. Expanded story scenes and game staging are still being revised.","slides":[{"src":"assets/manhua/revised-2026-09/page-09.webp","alt":"Chapter one, page 9: If the song is safe","caption":"IF THE SONG IS SAFE, PUT MY CELL BACK. — R.\nIF IT ISN'T, PLEASE BE CAREFUL.","motion":"push-in",